rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    // Admin membership can only be provisioned from Firebase Console/Admin SDK.
    match /adminAccess/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update: if false;
      // Users may revoke their own admin grant when deleting their account.
      allow delete: if owner(uid);
    }
    // A minimal UID-only marker prevents deleted profiles from being recreated by
    // other signed-in browser sessions. It is retained after self-deletion.
    function accountActive(uid) {
      return !exists(/databases/$(database)/documents/users/$(uid)/account/deletion);
    }
    function isReportingAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/adminAccess/$(request.auth.uid))
        && get(/databases/$(database)/documents/adminAccess/$(request.auth.uid)).data.enabled == true;
    }
    // Only aggregated, non-identity collector metrics are shared with the owner.
    match /collectorSummaries/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid || isReportingAdmin();
      allow list: if isReportingAdmin();
      allow create, update: if owner(uid) && accountActive(uid)
        && request.resource.data.keys().hasOnly(['owned','wishlist','themes','affiliateClicks','lastActive'])
        && request.resource.data.owned is int && request.resource.data.owned >= 0
        && request.resource.data.wishlist is int && request.resource.data.wishlist >= 0
        && request.resource.data.themes is map
        && (!('affiliateClicks' in request.resource.data) || request.resource.data.affiliateClicks is int);
      allow delete: if owner(uid);
    }
    match /collectorProfiles/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isReportingAdmin();
      allow create, update: if owner(uid) && accountActive(uid)
        && request.resource.data.keys().hasOnly(['name','email','firstSeen','lastSeen','communicationsOptIn'])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.firstSeen is string
        && request.resource.data.lastSeen is string
        && (!('communicationsOptIn' in request.resource.data) || request.resource.data.communicationsOptIn is bool);
      allow delete: if owner(uid);
    }
    match /users/{userId}/activity/{eventId} {
      allow read: if owner(userId) || isReportingAdmin();
      allow create: if owner(userId) && accountActive(userId)
        && request.resource.data.keys().hasOnly(['type','at','setNumber','theme'])
        && request.resource.data.type in ['owned','wishlist','removed','affiliate_click']
        && request.resource.data.at is string;
      allow update: if false;
      allow delete: if owner(userId);
    }
    match /users/{userId}/account/deletion {
      allow read: if owner(userId);
      allow create: if owner(userId)
        && request.resource.data.keys().hasOnly(['deleting'])
        && request.resource.data.deleting == true;
      // Immutable marker prevents stale sessions from recreating deleted records.
      allow update, delete: if false;
    }
    // Collector-owned copyrights; upload and display permissions are nonexclusive.
    function validPhotoData() {
      return request.resource.data.imageData is string
        && request.resource.data.imageData.size() <= 340000
        && request.resource.data.imageData.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+
      allow read, delete: if owner(userId) && section in ['items', 'groups'];
      allow create, update: if owner(userId) && section in ['items', 'groups']
        && !exists(/databases/$(database)/documents/users/$(userId)/account/deletion);
    }
  }
}
);
    }
    match /users/{userId}/setPhotos/{setNumber} {
      allow get: if owner(userId) || (isReportingAdmin() && resource.data.status == 'pending');
      allow list: if owner(userId);
      allow create, update: if owner(userId) && accountActive(userId)
        && exists(/databases/$(database)/documents/users/$(userId)/items/$('archiv-lego-set:' + setNumber))
        && get(/databases/$(database)/documents/users/$(userId)/items/$('archiv-lego-set:' + setNumber)).data.legoStatus == 'owned'
        && request.resource.data.keys().hasOnly([
          'ownerUid','setNumber','imageData','status','uploadedAt','submittedAt',
          'licenseVersion','communityConsent','consentedAt'
        ])
        && request.resource.data.keys().hasAll([
          'ownerUid','setNumber','imageData','status','uploadedAt','submittedAt',
          'licenseVersion','communityConsent','consentedAt'
        ])
        && request.resource.data.ownerUid == userId
        && request.resource.data.setNumber == setNumber
        && validPhotoData()
        && request.resource.data.status in ['private','pending']
        && request.resource.data.uploadedAt is string
        && request.resource.data.licenseVersion == 'archiv-community-photo-license-v1-2026-11-01'
        && request.resource.data.communityConsent is bool
        && (request.resource.data.status == 'private' ||
            (request.resource.data.communityConsent == true
             && request.resource.data.submittedAt is string
             && request.resource.data.consentedAt is string))
        && (request.resource.data.status != 'private' ||
            (request.resource.data.communityConsent == false
             && request.resource.data.submittedAt == null
             && request.resource.data.consentedAt == null));
      // Only moderators can approve or reject a pending image.
      allow update: if isReportingAdmin() && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','communityPhotoId'])
        && request.resource.data.status in ['approved','rejected']
        && (request.resource.data.status != 'approved' ||
            (request.resource.data.communityPhotoId is string
             && request.resource.data.communityPhotoId.size() >= 12));
      allow delete: if owner(userId);
    }
    match /{path=**}/setPhotos/{setNumber} {
      allow list: if isReportingAdmin() && resource.data.status == 'pending';
    }
    // Approved photos remain public by default, subject to verified removal requests.
    match /communitySetPhotos/{photoId} {
      allow get, list: if true;
      allow create: if isReportingAdmin()
        && request.resource.data.keys().hasOnly(['setNumber','imageData','approvedAt'])
        && request.resource.data.keys().hasAll(['setNumber','imageData','approvedAt'])
        && request.resource.data.setNumber is string
        && request.resource.data.approvedAt is string
        && validPhotoData();
      allow update: if false;
      allow delete: if isReportingAdmin();
    }
    // Nonpublic evidence of permission, not copyright ownership, may survive
    // account deletion as needed for rights disputes and removal verification.
    match /communityPhotoPermissions/{photoId} {
      allow get, list: if isReportingAdmin();
      allow create: if isReportingAdmin()
        && request.resource.data.keys().hasOnly([
          'ownerUid','setNumber','communityPhotoId','licenseVersion','consentedAt','approvedAt'
        ])
        && request.resource.data.keys().hasAll([
          'ownerUid','setNumber','communityPhotoId','licenseVersion','consentedAt','approvedAt'
        ])
        && request.resource.data.communityPhotoId == photoId
        && request.resource.data.ownerUid is string
        && request.resource.data.setNumber is string
        && request.resource.data.licenseVersion == 'archiv-community-photo-license-v1-2026-11-01'
        && request.resource.data.consentedAt is string
        && request.resource.data.approvedAt is string;
      allow update: if false;
      allow delete: if isReportingAdmin();
    }
    match /users/{userId}/{section}/{recordId} {
      allow read, delete: if owner(userId) && section in ['items', 'groups'];
      allow create, update: if owner(userId) && section in ['items', 'groups']
        && !exists(/databases/$(database)/documents/users/$(userId)/account/deletion);
    }
  }
}
