# Create a Firebase web app, enable Google Authentication and Cloud Firestore,
# and add jhoward02.github.io to Authentication > Authorized domains.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional administrator-only Google Analytics Data API reporting.
# Enter the Archív GA4 numeric PROPERTY ID, not its G- measurement ID.
# Use a Google Cloud OAuth 2.0 Web application client ID with the site origins
# authorized (https://jhoward02.github.io and your approved custom domain).
# Enable the Google Analytics Data API in that Google Cloud project.
# OAuth tokens are obtained interactively by authorized admins and never stored.
VITE_GA4_PROPERTY_ID=
VITE_GA4_OAUTH_CLIENT_ID=
